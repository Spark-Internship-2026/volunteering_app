rules_version = '2';

// RESTRICTED rules: what production runs while the app is still being built.
//
// Goal: block the things that are genuinely dangerous, and stay out of the teams' way
// for everything else.
//
//   BLOCKED                                          WHY
//   1. Changing your own role (or creating a         Anyone could make themselves staff.
//      user as staff)
//   2. Reading other people's user or signup         Names and emails of every volunteer.
//      documents
//   3. Non-staff creating, editing or deleting       Vandalism; events drive volunteer hours.
//      events
//   4. Overwriting or deleting someone else's        Including a signed-out visitor taking
//      signup                                        over a real signup by reusing its id.
//   5. Forging a signup as someone else, or          Hours credit must be trustworthy.
//      setting check-in / completion status
//
//   STILL OPEN (so teams can build without editing rules):
//   - any NEW top-level collection (signed-in users)
//   - any new fields on events (staff) and on users (own document, except `role`)
//   - any new fields that STAFF add to a signup (students can only write the core ones)
//
// Not fixable in rules: anyone can still create an account and spend read/write quota.
// Use a Firebase budget alert, and App Check later.
//
// Stricter launch rules (field lists everywhere): firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStudent() {
      return currentUserDocExists() && currentUserRole() == "student";
    }

    function isStaff() {
      return currentUserDocExists() && currentUserRole() == "staff";
    }

    function canUseSignedInSignup() {
      return isStudent() || isStaff();
    }

    // Collections with their own rules below. The open catch-all skips these.
    function isProtectedCollection(name) {
      return name in ["users", "opportunities", "signups", "eventTemplates"];
    }

    function verifiedEmailIs(email) {
      return isSignedIn()
        && request.auth.token.get("email_verified", false) == true
        && request.auth.token.email == email;
    }

    // ---- Signups ----
    function hasOnlyStudentSignupFields() {
      return request.resource.data.keys().hasOnly([
        "studentId",
        "studentName",
        "studentEmail",
        "opportunityId",
        "createdAt",
        "status"
      ]);
    }

    function hasRequiredSignupFields() {
      return request.resource.data.keys().hasAll([
        "studentId",
        "studentName",
        "studentEmail",
        "opportunityId",
        "createdAt"
      ]);
    }

    function signupDocumentIdMatchesEmail(signupId) {
      return signupId == request.resource.data.opportunityId + "_" + request.resource.data.studentEmail;
    }

    function hasValidSignedInSignupFields() {
      return request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.opportunityId is string
        && request.resource.data.opportunityId.size() > 0;
    }

    function hasValidGuestSignupFields() {
      return !isSignedIn()
        && request.resource.data.studentId == "guest"
        && request.resource.data.studentName == "GUEST"
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail.size() > 3
        && request.resource.data.studentEmail.size() <= 320
        && request.resource.data.opportunityId is string
        && request.resource.data.opportunityId.size() > 0;
    }

    function signupKeepsSameEmailAndEvent() {
      return request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.opportunityId == resource.data.opportunityId;
    }

    function signupOpportunityPath() {
      return /databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId);
    }

    function signupIsOpen() {
      return exists(signupOpportunityPath())
        && (
          !get(signupOpportunityPath()).data.keys().hasAny(["signupClosesAt"])
          || (
            get(signupOpportunityPath()).data.signupClosesAt is timestamp
            && request.time < get(signupOpportunityPath()).data.signupClosesAt
          )
        );
    }

    function validSignupStatus() {
      return !request.resource.data.keys().hasAny(["status"])
        || request.resource.data.status in ["signed_up", "checked_in", "completed"];
    }

    // Students and guests cannot set check-in/completion when creating a signup...
    function signupStatusAbsentOnCreate() {
      return !request.resource.data.keys().hasAny(["checkedInAt", "completedAt"])
        && (
          !request.resource.data.keys().hasAny(["status"])
          || request.resource.data.status == "signed_up"
        );
    }

    // ...or change it afterwards.
    function signupStatusUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["status", "checkedInAt", "completedAt"]);
    }

    // Staff may change anything on a signup except who it belongs to.
    function signupIdentityUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["studentId", "studentName", "studentEmail", "opportunityId", "createdAt"]);
    }

    // ---- Live capacity counter (opportunities.signupCount) ----
    function ownSignupPath(opportunityId) {
      return /databases/$(database)/documents/signups/$(opportunityId + "_" + request.auth.token.email);
    }

    function signupCreatedInSameWrite(opportunityId) {
      return !exists(ownSignupPath(opportunityId))
        && existsAfter(ownSignupPath(opportunityId));
    }

    function signupDeletedInSameWrite(opportunityId) {
      return exists(ownSignupPath(opportunityId))
        && !existsAfter(ownSignupPath(opportunityId));
    }

    function currentSignupCount() {
      return resource.data.get("signupCount", 0);
    }

    function onlySignupCountChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["signupCount"])
        && request.resource.data.signupCount is int
        && request.resource.data.signupCount >= 0
        && (
          !resource.data.keys().hasAny(["capacity"])
          || request.resource.data.signupCount <= resource.data.capacity
        );
    }

    // 1 + 2: users. Own document only; the role can never be changed by the user.
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.role == "student";

      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // 3: events. Staff do everything; everyone else only bumps the capacity counter.
    match /opportunities/{opportunityId} {
      allow get: if true;
      allow list: if isSignedIn();

      allow create, update, delete: if isStaff();

      // Anyone signing up may add exactly 1 to the counter, and a signed-in user must
      // create their own signup in the same write. Signed-out guests cannot be tied to
      // a signup by rules, so their +1 is unpaired (known limitation).
      allow update: if onlySignupCountChanges()
        && (
          (
            request.resource.data.signupCount == currentSignupCount() + 1
            && (
              !isSignedIn()
              || (canUseSignedInSignup() && signupCreatedInSameWrite(opportunityId))
            )
          )
          || (
            request.resource.data.signupCount == currentSignupCount() - 1
            && canUseSignedInSignup()
            && signupDeletedInSameWrite(opportunityId)
          )
        );
    }

    // Reusable event templates (staff only).
    match /eventTemplates/{templateId} {
      allow read, write: if isStaff();
    }

    // 2, 4, 5: signups.
    match /signups/{signupId} {
      // Create your own signup (or a guest one).
      allow create: if signupDocumentIdMatchesEmail(signupId)
        && hasOnlyStudentSignupFields()
        && hasRequiredSignupFields()
        && signupStatusAbsentOnCreate()
        && signupIsOpen()
        && (
          (canUseSignedInSignup() && hasValidSignedInSignupFields())
          || hasValidGuestSignupFields()
        );

      // Re-save your own signup. Guests may only re-save a signup that is already a
      // guest signup, never take over a real one.
      allow update: if signupDocumentIdMatchesEmail(signupId)
        && hasOnlyStudentSignupFields()
        && hasRequiredSignupFields()
        && signupKeepsSameEmailAndEvent()
        && signupStatusUntouched()
        && signupIsOpen()
        && (
          (canUseSignedInSignup() && hasValidSignedInSignupFields())
          || (hasValidGuestSignupFields() && resource.data.studentId == "guest")
        );

      // Staff check students in, mark them complete, or add any fields they like.
      allow update: if isStaff()
        && signupIdentityUntouched()
        && validSignupStatus();

      // A verified account claims a guest signup made with the same email.
      allow update: if resource.data.studentId == "guest"
        && verifiedEmailIs(resource.data.studentEmail)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["studentId", "studentName"])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0;

      allow read: if isSignedIn()
        && (
          resource.data.studentId == request.auth.uid
          || isStaff()
          || verifiedEmailIs(resource.data.studentEmail)
        );

      // Remove your own signup; staff can remove any (for example when deleting an event).
      allow delete: if (
          canUseSignedInSignup()
          && resource.data.studentId == request.auth.uid
        )
        || isStaff();
    }

    // Everything else: any signed-in user, so teams can add collections freely.
    // The four collections above are excluded so they can only use their own rules
    // (Firestore adds up every matching rule, so this must not cover them).
    match /{collection}/{document=**} {
      allow read, write: if isSignedIn() && !isProtectedCollection(collection);
    }
  }
}

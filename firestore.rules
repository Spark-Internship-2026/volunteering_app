rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStudent() {
      return currentUserDocExists() && currentUserRole() == "student";
    }

    function isStaff() {
      return currentUserDocExists() && currentUserRole() == "staff";
    }

    function hasOnlyUserFields() {
      return request.resource.data.keys().hasOnly(["name", "email", "role", "createdAt"]);
    }

    function hasOnlyOpportunityFields() {
      return request.resource.data.keys().hasOnly([
        "title",
        "description",
        "location",
        "hours",
        "date",
        "wrapUpSummary",
        "videoUrl",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasOnlySignupFields() {
      return request.resource.data.keys().hasOnly([
        "studentId",
        "studentName",
        "studentEmail",
        "opportunityId",
        "createdAt"
      ]);
    }

    function hasRequiredOpportunityFields() {
      return request.resource.data.keys().hasAll([
        "title",
        "hours",
        "date",
        "createdBy",
        "createdAt"
      ]);
    }

    function hasValidOpportunityFields() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.hours is number
        && request.resource.data.hours > 0
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0;
    }

    function hasRequiredSignupFields() {
      return request.resource.data.keys().hasAll([
        "studentId",
        "studentName",
        "studentEmail",
        "opportunityId",
        "createdAt"
      ]);
    }

    function hasValidStudentSignupFields() {
      return request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.opportunityId is string
        && request.resource.data.opportunityId.size() > 0;
    }

    function hasValidGuestSignupFields() {
      return !isSignedIn()
        && request.resource.data.studentId == "guest"
        && request.resource.data.studentName == "GUEST"
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail.size() > 3
        && request.resource.data.studentEmail.size() <= 320
        && request.resource.data.opportunityId is string
        && request.resource.data.opportunityId.size() > 0;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasOnlyUserFields()
        && request.resource.data.role == "student";

      allow update: if isOwner(userId)
        && hasOnlyUserFields()
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /opportunities/{opportunityId} {
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if isStaff()
        && hasOnlyOpportunityFields()
        && hasRequiredOpportunityFields()
        && hasValidOpportunityFields()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isStaff()
        && hasOnlyOpportunityFields()
        && hasRequiredOpportunityFields()
        && hasValidOpportunityFields()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isStaff();
    }

    match /signups/{signupId} {
      allow create: if hasOnlySignupFields()
        && hasRequiredSignupFields()
        && (
          (isStudent() && hasValidStudentSignupFields())
          || hasValidGuestSignupFields()
        );

      allow read: if isSignedIn()
        && (
          resource.data.studentId == request.auth.uid
          || isStaff()
        );

      allow update: if false;

      allow delete: if isStudent()
        && resource.data.studentId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

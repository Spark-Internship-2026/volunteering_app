rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStudent() {
      return currentUserDocExists() && currentUserRole() == "student";
    }

    function isStaff() {
      return currentUserDocExists() && currentUserRole() == "staff";
    }

    function canUseSignedInSignup() {
      return isStudent() || isStaff();
    }

    function hasOnlyUserFields() {
      return request.resource.data.keys().hasOnly(["name", "email", "role", "createdAt"]);
    }

    function hasOnlyOpportunityFields() {
      return request.resource.data.keys().hasOnly([
        "title",
        "description",
        "location",
        "hours",
        "date",
        "wrapUpSummary",
        "videoUrl",
        "createdBy",
        "createdAt",
        "signupClosesAt",
        "updatedAt",
        "capacity",
        "signupCount",
        "templateId",
        "seriesId",
        "recurrence"
      ]);
    }

    function hasOnlySignupFields() {
      return request.resource.data.keys().hasOnly([
        "studentId",
        "studentName",
        "studentEmail",
        "opportunityId",
        "createdAt",
        "status",
        "checkedInAt",
        "completedAt"
      ]);
    }

    function hasRequiredOpportunityFields() {
      return request.resource.data.keys().hasAll([
        "title",
        "hours",
        "date",
        "createdBy",
        "createdAt"
      ]);
    }

    function hasRequiredNewOpportunityFields() {
      return hasRequiredOpportunityFields()
        && request.resource.data.keys().hasAll(["signupClosesAt"]);
    }

    function hasValidOpportunityFields() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.hours is number
        && request.resource.data.hours > 0
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0
        && (
          !request.resource.data.keys().hasAny(["signupClosesAt"])
          || request.resource.data.signupClosesAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(["capacity"])
          || (request.resource.data.capacity is int && request.resource.data.capacity > 0)
        )
        && (
          !request.resource.data.keys().hasAny(["signupCount"])
          || (request.resource.data.signupCount is int && request.resource.data.signupCount >= 0)
        );
    }

    function hasRequiredSignupFields() {
      return request.resource.data.keys().hasAll([
        "studentId",
        "studentName",
        "studentEmail",
        "opportunityId",
        "createdAt"
      ]);
    }

    function signupDocumentIdMatchesEmail(signupId) {
      return signupId == request.resource.data.opportunityId + "_" + request.resource.data.studentEmail;
    }

    function hasValidSignedInSignupFields() {
      return request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.opportunityId is string
        && request.resource.data.opportunityId.size() > 0;
    }

    function signupKeepsSameEmailAndEvent() {
      return request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.opportunityId == resource.data.opportunityId;
    }

    function signupOpportunityPath() {
      return /databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId);
    }

    function signupIsOpen() {
      return exists(signupOpportunityPath())
        && (
          !get(signupOpportunityPath()).data.keys().hasAny(["signupClosesAt"])
          || (
            get(signupOpportunityPath()).data.signupClosesAt is timestamp
            && request.time < get(signupOpportunityPath()).data.signupClosesAt
          )
        );
    }

    function hasValidGuestSignupFields() {
      return !isSignedIn()
        && request.resource.data.studentId == "guest"
        && request.resource.data.studentName == "GUEST"
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail.size() > 3
        && request.resource.data.studentEmail.size() <= 320
        && request.resource.data.opportunityId is string
        && request.resource.data.opportunityId.size() > 0;
    }

    // ---- Signup status (check-in / completion): staff only ----
    function validSignupStatus() {
      return !request.resource.data.keys().hasAny(["status"])
        || request.resource.data.status in ["signed_up", "checked_in", "completed"];
    }

    // Students and guests may not set status fields when creating a signup.
    function signupStatusAbsentOnCreate() {
      return !request.resource.data.keys().hasAny(["checkedInAt", "completedAt"])
        && (
          !request.resource.data.keys().hasAny(["status"])
          || request.resource.data.status == "signed_up"
        );
    }

    // ...and may not change them on an existing signup.
    function signupStatusUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["status", "checkedInAt", "completedAt"]);
    }

    function onlySignupStatusChanges() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["status", "checkedInAt", "completedAt"]);
    }

    // ---- Guest signups linked to an account later (verified email only) ----
    function verifiedEmailIs(email) {
      return isSignedIn()
        && request.auth.token.get("email_verified", false) == true
        && request.auth.token.email == email;
    }

    // ---- Live capacity counter (opportunities.signupCount) ----
    // A signed-in user's own signup doc for an event.
    function ownSignupPath(opportunityId) {
      return /databases/$(database)/documents/signups/$(opportunityId + "_" + request.auth.token.email);
    }

    function signupCreatedInSameWrite(opportunityId) {
      return !exists(ownSignupPath(opportunityId))
        && existsAfter(ownSignupPath(opportunityId));
    }

    function signupDeletedInSameWrite(opportunityId) {
      return exists(ownSignupPath(opportunityId))
        && !existsAfter(ownSignupPath(opportunityId));
    }

    function currentSignupCount() {
      return resource.data.get("signupCount", 0);
    }

    function onlySignupCountChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["signupCount"])
        && request.resource.data.signupCount is int
        && request.resource.data.signupCount >= 0
        && (
          !resource.data.keys().hasAny(["capacity"])
          || request.resource.data.signupCount <= resource.data.capacity
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasOnlyUserFields()
        && request.resource.data.role == "student";

      allow update: if isOwner(userId)
        && hasOnlyUserFields()
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /opportunities/{opportunityId} {
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if isStaff()
        && hasOnlyOpportunityFields()
        && hasRequiredNewOpportunityFields()
        && hasValidOpportunityFields()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isStaff()
        && hasOnlyOpportunityFields()
        && hasRequiredOpportunityFields()
        && hasValidOpportunityFields()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      // Live capacity: anyone signing up may bump the counter by exactly 1, and
      // a signed-in user must create their own signup in the same write.
      // Signed-out guests cannot be tied to a signup doc by rules, so their +1 is
      // unpaired (known limitation; a server-side check is the long-term fix).
      allow update: if onlySignupCountChanges()
        && (
          (
            request.resource.data.signupCount == currentSignupCount() + 1
            && (
              !isSignedIn()
              || (canUseSignedInSignup() && signupCreatedInSameWrite(opportunityId))
            )
          )
          || (
            request.resource.data.signupCount == currentSignupCount() - 1
            && canUseSignedInSignup()
            && signupDeletedInSameWrite(opportunityId)
          )
        );

      allow delete: if isStaff();
    }

    // Reusable event templates for staff.
    match /eventTemplates/{templateId} {
      allow read, write: if isStaff();
    }

    match /signups/{signupId} {
      allow create: if signupDocumentIdMatchesEmail(signupId)
        && hasOnlySignupFields()
        && hasRequiredSignupFields()
        && signupStatusAbsentOnCreate()
        && signupIsOpen()
        && (
          (canUseSignedInSignup() && hasValidSignedInSignupFields())
          || hasValidGuestSignupFields()
        );

      allow update: if signupDocumentIdMatchesEmail(signupId)
        && hasOnlySignupFields()
        && hasRequiredSignupFields()
        && signupKeepsSameEmailAndEvent()
        && signupStatusUntouched()
        && signupIsOpen()
        && (
          (canUseSignedInSignup() && hasValidSignedInSignupFields())
          || hasValidGuestSignupFields()
        );

      // Staff check students in / mark them complete.
      allow update: if isStaff()
        && onlySignupStatusChanges()
        && validSignupStatus();

      // A verified account claims a guest signup made with the same email.
      allow update: if resource.data.studentId == "guest"
        && verifiedEmailIs(resource.data.studentEmail)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["studentId", "studentName"])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0;

      allow read: if isSignedIn()
        && (
          resource.data.studentId == request.auth.uid
          || isStaff()
          || verifiedEmailIs(resource.data.studentEmail)
        );

      // Students remove their own signup; staff can remove any (e.g. deleting an event).
      allow delete: if (
          canUseSignedInSignup()
          && resource.data.studentId == request.auth.uid
        )
        || isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
